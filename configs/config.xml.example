<config>
    <!-- Paths are relative to this config file or absolute -->
    <feeds>../feeds.xml</feeds>
    <env>env.xml</env>
    <limit>10</limit>
    <max-age-hours>24</max-age-hours>
    <summary>false</summary>
    <extractor>newspaper</extractor>
    <concurrency>10</concurrency>
    <http>
        <connect-timeout>5</connect-timeout>
        <read-timeout>20</read-timeout>
        <max-feed-bytes>5242880</max-feed-bytes>
        <max-article-bytes>10485760</max-article-bytes>
        <retries>2</retries>
        <backoff-seconds>0.5</backoff-seconds>
        <per-host-concurrency>2</per-host-concurrency>
    </http>
    <pre-filter>
        <enabled>false</enabled>
        <!-- full-text is the compatibility default; metadata-first reduces page downloads -->
        <mode>full-text</mode>
        <candidate-multiplier>3</candidate-multiplier>
        <embeddings-path>../query_embeddings.json</embeddings-path>
        <queries-file>../queries.txt</queries-file>
        <cluster-threshold>0.8</cluster-threshold>
    </pre-filter>
    <embeddings>
        <provider>fastembed</provider>
        <model>intfloat/multilingual-e5-large</model>
    </embeddings>
    <llm>
        <!-- gemini uses GOOGLE_API_KEY/GEMINI_API_KEY; openrouter uses OPENROUTER_API_KEY -->
        <provider>gemini</provider>
        <model>gemini-flash-latest</model>
    </llm>
    <email>
        <to></to>
        <from></from>
        <subject>Morning RSS Digest</subject>
    </email>
    <logging>
        <level>INFO</level>
        <file>../logs/rss-morning.log</file>
    </logging>
    <prompt file="../prompt.md" />
</config>
