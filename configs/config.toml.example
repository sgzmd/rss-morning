# RSS Morning Configuration

# Path to the OPML feeds file (relative to this config or absolute)
feeds = "feeds.xml"

# Optional path to .env file for secrets (or use system environment variables)
# env_file = ".env"

# Maximum articles to process per feed
limit = 10

# Maximum age of articles in hours (optional)
max_age_hours = 24.0

# Generate AI summary digest
summary = true

# HTTP extraction concurrency
concurrency = 10

# Maximum characters per article body
max_article_length = 250

# Optional editorial prompt file or inline prompt
prompt_file = "prompt.md"

[classification]
# Jev (TypeSafe System One) metadata pre-filter
enabled = true
model = "jev-latest"
threshold = 0.50

[email]
to = "user@example.com"
from = "mailer@example.com"
subject = "Morning RSS Digest"

[logging]
level = "INFO"
file = "logs/rss-morning.log"

[llm]
# OpenRouter generative model for the final edition editor call
model = "google/gemini-3.8-flash"
# Reasoning effort for models that support it (e.g. Gemini Flash, Sonnet)
reasoning_effort = "low"

[digest]
# Pyramid structure configuration
exec_summary_points = 5
max_topics = 6
deep_dives = 3
editor_article_chars = 1500
deep_dive_article_chars = 10000
# Optional dedicated model for Stage 2 technical deep dives (defaults to llm.model)
# deep_dive_model = "google/gemini-3.8-flash"

# Focus areas with semantic Jev criteria and individual thresholds
[areas.mobile_security]
label = "Mobile Security"
threshold = 0.40
description = "Mobile application security, Android and iOS vulnerabilities, mobile malware, device attestation, and client integrity."

[areas.corporate_security]
label = "Corporate Security"
threshold = 0.45
description = "Enterprise networking, VPN, SD-WAN, firewalls, identity providers, managed devices, browsers, and workplace IT infrastructure."

[areas.account_takeover]
label = "Account Takeover"
threshold = 0.40
description = "Account takeover, credential stuffing, session hijacking, password spraying, brute force, and customer identity compromise."

[areas.end_user_security]
label = "End-User Security (Passkeys & Modern Auth)"
threshold = 0.40
description = "Passkeys, FIDO2, WebAuthn, modern authentication methods, biometric login, MFA adoption, and end-user identity protection."

[areas.ai_security]
label = "AI Security"
threshold = 0.50
description = "AI model vulnerabilities, prompt injection, AI agent safety, and security implications of LLMs and generative AI."

[areas.other]
label = "Everything Else & Notable CVEs"
threshold = 0.75
description = "General security news, notable CVEs, software vulnerabilities, infrastructure, or material not fitting any specific focus area above."

