# RSS Morning Environment Secrets
# Copy to .env or export in your environment

# TypeSafe API key for Jev classification
TYPESAFE_API_KEY=your_typesafe_api_key_here

# OpenRouter API key for LLM edition synthesis
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Resend API key for sending email digests
RESEND_API_KEY=your_resend_api_key_here
